\ ***************************************************************************
\ PRINT, as the original's strings use it through the ROM's PR-STRING
\ (docs/research/graphics.md): INK, PAPER, FLASH and BRIGHT codes, AT, and
\ characters from the current font, each drawn whole over its cell with
\ the cell's attribute set.
\
\ The attributes: the game logic reads them (ATTR, the grass's 65 under a
\ landing), so the port keeps the Spectrum's attribute file as it would
\ be, `attrs` (32 a row), beside the screen.
\ ***************************************************************************

ZA_AUTO2 attr_ptr               ; the cell's attribute, set by cell_at

\ attr_ptr = attrs + 32 * row A + column X. A and X are kept.
.attr_at
{
    PHA
    STA attr_ptr+1
    LDA #0
    LSR attr_ptr+1 : ROR A : LSR attr_ptr+1 : ROR A : LSR attr_ptr+1 : ROR A
    STX attr_ptr : ORA attr_ptr : STA attr_ptr      ; (32 * row + column)
    LDA attr_ptr+1 : ADC #HI(attrs) : STA attr_ptr+1 ; (C clear: the ORA)
    ASSERT LO(attrs) = 0
    PLA
    RTS
}

\ The cell at attr_ptr takes attribute A. Y = 0 after.
.set_attr
    LDY #0 : STA (attr_ptr),Y
    RTS

\ Rows A to 23 of the attributes take attribute X, as CLS or 45710's
\ clearing would leave them.
.fill_attrs
{
    ZA_AUTO1 value
    STX value
    LDX #0 : JSR attr_at
.row
    LDY #31 : LDA value
.cell
    STA (attr_ptr),Y
    DEY : BPL cell
    LDA attr_ptr : CLC : ADC #32 : STA attr_ptr
    BCC same : INC attr_ptr+1
.same
    LDA attr_ptr+1 : CMP #HI(attrs + 768) : BNE row
    ASSERT LO(attrs) = 0            ; (so the last row ends a page)
    RTS
}

\ --- The PRINT state ------------------------------------------------------
\ The current font is print_font: glyph c at print_font + 8c (the
\ Spectrum's CHARS + 256).
ZA_AUTO2 print_font
ZA_AUTO2 print_src              ; the string
ZA_AUTO1 print_len              ; ... its length left
ZA_AUTO1 p_ink                  ; ATTR_T's ink
ZA_AUTO1 p_bright               ; ... and BRIGHT, as &40 or 0
ZA_AUTO1 p_row                  ; the print position
ZA_AUTO1 p_col

\ PRINT the string at print_src, print_len bytes long, starting from
\ attribute A (as ATTR_P gives it: CHAN-OPEN copies it to ATTR_T).
.print_string
{
    TAX : AND #7 : STA p_ink
    TXA : AND #&40 : STA p_bright
.next
    LDA print_len : BEQ done
    JSR fetch
    CMP #&20 : BCS char
    CMP #&16 : BEQ at
    CMP #&10 : BEQ ink
    CMP #&13 : BEQ bright
    CMP #&11 : BEQ skip1            ; PAPER: black throughout the original
    CMP #&12 : BEQ skip1            ; FLASH: never on
.bad
    JMP bad                         ; (a code the original's strings don't use)
.skip1
    JSR fetch
    JMP next
.ink
    JSR fetch : AND #7 : STA p_ink
    JMP next
.bright
    JSR fetch : AND #1 : BEQ b0
    LDA #&40
.b0 STA p_bright
    JMP next
.at
    JSR fetch : STA p_row
    JSR fetch : STA p_col
    JMP next
.char
    JSR print_char
    JMP next
.done
    RTS
.fetch
    LDY #0 : LDA (print_src),Y
    INC print_src : BNE f1 : INC print_src+1
.f1 DEC print_len
    RTS
}

\ Draw character A at p_row, p_col in p_ink and p_bright, and move on.
.print_char
{
    LDX #0 : STX glyph+1
    ASL A : ROL glyph+1 : ASL A : ROL glyph+1 : ASL A : ROL glyph+1
    CLC : ADC print_font : STA glyph
    LDA glyph+1 : ADC print_font+1 : STA glyph+1
    LDA p_row : LDX p_ink : JSR ink_for
    LDA p_row : LDX p_col : JSR cell_at
    LDA p_ink : ORA p_bright : JSR set_attr
    JSR draw_cell
    INC p_col
    LDA p_col : CMP #32 : BNE same
    LDA #0 : STA p_col
    INC p_row
.same
    RTS
}
