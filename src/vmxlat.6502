\ ***************************************************************************
\ vm_xlat's tables: where the port keeps the original's memory that the
\ compiled BASIC addresses by value (PEEK, POKE, DPEEK, DPOKE). Regions
\ (first, end, the port's start) and single bytes, the system variables.
\ Each layer adds what its data needs.
\ ***************************************************************************
XLAT_FROM = {41015, 24603, 24759}
XLAT_TO   = {41575, 24759, 24823}
XLAT_PORT = {bv, bslots, sprite_blocks}
XLAT_REGIONS = 3
.xlat_from_lo
FOR n = 0..XLAT_REGIONS-1 : EQUB LO(XLAT_FROM[n]) : NEXT
.xlat_from_hi
FOR n = 0..XLAT_REGIONS-1 : EQUB HI(XLAT_FROM[n]) : NEXT
.xlat_to_lo
FOR n = 0..XLAT_REGIONS-1 : EQUB LO(XLAT_TO[n]) : NEXT
.xlat_to_hi
FOR n = 0..XLAT_REGIONS-1 : EQUB HI(XLAT_TO[n]) : NEXT
.xlat_add_lo
FOR n = 0..XLAT_REGIONS-1 : EQUB LO(XLAT_PORT[n] - XLAT_FROM[n]) : NEXT
.xlat_add_hi
FOR n = 0..XLAT_REGIONS-1 : EQUB HI(XLAT_PORT[n] - XLAT_FROM[n]) : NEXT

XLAT_SYS_FROM = {23563, 23564, 23672, 23673, 23296, 23297, 23606, 23607, 23693, 23695, 23728, 23729}
XLAT_SYS_PORT = {rnd_seed, rnd_seed+1, frames, frames+1, prbuf, prbuf+1, chars, chars+1, attr_p, attr_t, stick_res, stick_res+1}
XLAT_SYS = 12
.xlat_sys_lo
FOR n = 0..XLAT_SYS-1 : EQUB LO(XLAT_SYS_FROM[n]) : NEXT
.xlat_sys_hi
FOR n = 0..XLAT_SYS-1 : EQUB HI(XLAT_SYS_FROM[n]) : NEXT
.xlat_sys_plo
FOR n = 0..XLAT_SYS-1 : EQUB LO(XLAT_SYS_PORT[n]) : NEXT
.xlat_sys_phi
FOR n = 0..XLAT_SYS-1 : EQUB HI(XLAT_SYS_PORT[n]) : NEXT
