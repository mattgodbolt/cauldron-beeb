\ ***************************************************************************
\ SPRITE: the compiler library's sprite routine (25431,
\ docs/research/runtime.md), without its colour clash (decision 5). A
\ parameter block (sprite_blocks, eight of 8 bytes, as the original's at
\ 24759) gives the graphic's address (the original's), x, y in PLOT
\ coordinates (175 the top line), rows, width in bytes, an attribute mode
\ and an attribute. Each pixel row XORs onto the screen, unmasked; before
\ it, the attributes of the cells it covers change by the mode:
\
\   0: a cell still ATTR_P takes the block's attribute (draw underground)
\   1: a cell with the block's attribute goes back to ATTR_P (its erase)
\   2: the cell takes the print colours, (old AND MASK_T) OR (ATTR_T AND
\      NOT MASK_T), as the ROM's PO-ATTR (outdoors)
\
\ The attributes are kept exactly (`attrs`: the game logic reads them),
\ and the screen's lit and unlit pixels are exactly the original's (the
\ logic's POINT reads them). Only the colours differ: a pixel the XOR
\ lights takes the scenery's colour if the scenery has it lit (the cell's
\ glyph, cell_info) and the sprite's colour if not; a lit pixel the XOR
\ leaves lit keeps its colour.
\
\ Nothing clips: a row running past column 31 carries on where the
\ Spectrum's screen address + i goes, and its attribute where the
\ original's derives it from that address (sprite_dest).
\ ***************************************************************************

SPR_MAX_W = 4                   ; the widest graphic (the door's 4 bytes)
\ The doors' frames, by the original's address: door_gfx32's (52300, 4
\ frames of 32 x 4 bytes) and door_gfx24's (53532, 4 of 24 x 2).
DOOR_FROM = {52300, 53532}
DOOR_TO   = {52300 + 4 * 128, 53532 + 4 * 48}

ZA_AUTO2 spr_gfx                ; the graphic's next row
ZA_AUTO1 spr_line               ; the screen line of the next row (175 - y)
ZA_AUTO1 spr_rows
ZA_AUTO1 spr_w
ZA_AUTO1 spr_mode
ZA_AUTO1 spr_attr
ZA_AUTO1 spr_ink                ; the sprite's own colour, a Spectrum ink
ZA_AUTO1 spr_door               ; a door: its own colour is its cell's
ZA_AUTO1 spr_fast               ; no row runs past column 31: sprite_cache's way
ZA_AUTO1 spr_crow               ; the character row sc_... hold
ZA_AUTO1 spr_shift              ; x MOD 8
ZA_AUTO1 spr_col                ; x DIV 8
ZA_AUTO1 spr_cells              ; cells a row covers: w, or w + 1 shifted
ZA_AUTO1 spr_i
ZA_AUTO1 dst_line               ; sprite_dest's: where cell i of the row goes
ZA_AUTO1 dst_col
ZA_AUTO1 dst_arow               ; ... and the attribute it changes
ZA_AUTO1 dst_acol

\ Draw sprite block X (0-7).
.sprite
{
    TXA : ASL A : ASL A : ASL A : TAX
    LDA sprite_blocks,X : STA spr_gfx
    LDA sprite_blocks+1,X : STA spr_gfx+1
    LDA sprite_blocks+2,X : PHA
    LDA #175 : SEC : SBC sprite_blocks+3,X : STA spr_line
    LDA sprite_blocks+4,X : STA spr_rows
    LDA sprite_blocks+5,X : STA spr_w
    LDA sprite_blocks+6,X : STA spr_mode
    LDA sprite_blocks+7,X : STA spr_attr
    \ The doors' graphics are scenery (decision 5): their pixels take the
    \ colour the original shows them in, their cell's ink.
    LDX #0 : STX spr_door : STX spr_fast
.door
    LDA spr_gfx : CMP door_from_lo,X
    LDA spr_gfx+1 : SBC door_from_hi,X : BCC next_door   ; below its start
    LDA spr_gfx : CMP door_to_lo,X
    LDA spr_gfx+1 : SBC door_to_hi,X : BCS next_door     ; at or past its end
    INC spr_door
.next_door
    INX : CPX #2 : BNE door
    JSR sprite_gfx
    PLA : PHA : AND #7 : STA spr_shift
    CMP #1                          ; (C set if shifted: one more cell)
    LDA spr_w : ADC #0 : STA spr_cells
    PLA : LSR A : LSR A : LSR A : STA spr_col
    \ The sprite's colour: the ink its mode would give a cell.
    LDA spr_attr
    LDX spr_mode : BEQ ink
    LDA attr_p
    DEX : BEQ ink
    LDA attr_t
.ink
    AND #7 : STA spr_ink
    LDA spr_rows : BEQ done
    LDA #&FF : STA spr_crow         ; (no cells cached)
    \ Rows that stay in columns 0-31 (as good as all): each cell's place,
    \ scenery and colours are its character row's, worked out once.
    LDA spr_col : CLC : ADC spr_cells
    CMP #33 : BCS row
    LDA #1 : STA spr_fast
.row
    JSR sprite_shift
    LDA spr_fast : BEQ slow
    LDA spr_line : LSR A : LSR A : LSR A
    CMP spr_crow : BEQ cached
    STA spr_crow
    JSR sprite_cache
.cached
    JSR sprite_fast_row
    JMP row_done
.slow
    LDA #0 : STA spr_i
.cell
    JSR sprite_dest
    JSR sprite_attr
    JSR sprite_byte
    INC spr_i : LDA spr_i : CMP spr_cells : BNE cell
.row_done
    INC spr_line
    LDA spr_gfx : CLC : ADC spr_w : STA spr_gfx
    BCC next : INC spr_gfx+1
.next
    DEC spr_rows : BNE row
.done
    RTS
}

\ spr_gfx: the original's address of the graphic, made the port's (the
\ regions of tools/mkdata.py's sprites.bin, one after another).
.sprite_gfx
{
    LDX #0
.region
    LDA spr_gfx : CMP region_from_lo,X
    LDA spr_gfx+1 : SBC region_from_hi,X : BCC next     ; below its start
    LDA spr_gfx : CMP region_to_lo,X
    LDA spr_gfx+1 : SBC region_to_hi,X : BCS next       ; at or past its end
    LDA spr_gfx : CLC : ADC region_add_lo,X : STA spr_gfx
    LDA spr_gfx+1 : ADC region_add_hi,X : STA spr_gfx+1
    RTS
.next
    INX : CPX #SPR_REGIONS : BNE region
.none
    JMP none                        ; (no graphic there: the original has none)
}
\ The regions and where each starts in sprites.bin (tools/mkdata.py).
INCLUDE "../build/data/sprmap.6502"
SPR_START = sprites + SPR_AT
.door_from_lo   EQUB LO(DOOR_FROM[0]), LO(DOOR_FROM[1])
.door_from_hi   EQUB HI(DOOR_FROM[0]), HI(DOOR_FROM[1])
.door_to_lo     EQUB LO(DOOR_TO[0]), LO(DOOR_TO[1])
.door_to_hi     EQUB HI(DOOR_TO[0]), HI(DOOR_TO[1])
.region_from_lo
FOR n = 0..SPR_REGIONS-1 : EQUB LO(SPR_FROM[n]) : NEXT
.region_from_hi
FOR n = 0..SPR_REGIONS-1 : EQUB HI(SPR_FROM[n]) : NEXT
.region_to_lo
FOR n = 0..SPR_REGIONS-1 : EQUB LO(SPR_TO[n]) : NEXT
.region_to_hi
FOR n = 0..SPR_REGIONS-1 : EQUB HI(SPR_TO[n]) : NEXT
.region_add_lo
FOR n = 0..SPR_REGIONS-1 : EQUB LO(SPR_START[n] - SPR_FROM[n]) : NEXT
.region_add_hi
FOR n = 0..SPR_REGIONS-1 : EQUB HI(SPR_START[n] - SPR_FROM[n]) : NEXT

\ The graphic's row into spr_buf, shifted right by spr_shift: spr_cells
\ bytes. A shift of 5 to 7 is done as one left of 8 less it, with the
\ row a byte along: the same bytes (the row with a zero byte after it,
\ shifted right by s, is the row with one before it shifted left by 8 - s),
\ in at most 4 shifts.
.sprite_shift
{
    LDA #0
    FOR n = 0..SPR_MAX_W
        STA spr_buf + n
    NEXT
    LDA spr_shift : CMP #5 : BCS left
    LDY spr_w : DEY
.copy
    LDA (spr_gfx),Y : STA spr_buf,Y
    DEY : BPL copy
    LDX spr_shift : BEQ done
.right
    LSR spr_buf
    FOR n = 1..SPR_MAX_W
        ROR spr_buf + n
    NEXT
    DEX : BNE right
.done
    RTS
.left
    LDY spr_w : DEY
.copy1
    LDA (spr_gfx),Y : STA spr_buf+1,Y
    DEY : BPL copy1
    LDA #8 : SEC : SBC spr_shift : TAX
.shl
    ASL spr_buf + SPR_MAX_W
    FOR n = SPR_MAX_W-1..0
        ROL spr_buf + n
    NEXT
    DEX : BNE shl
    RTS
}
.spr_buf    SKIP SPR_MAX_W + 1

\ Where cell spr_i of the row on spr_line goes: the Spectrum's screen
\ address of (spr_line, spr_col) plus spr_i, as dst_line, dst_col, and
\ the attribute the original derives from that address (its low byte
\ with the third from the high byte), dst_arow, dst_acol. Past column
\ 31 the address's low byte carries into the character row in the third,
\ and from the third's last row into the high byte: the pixel line, and
\ from line 7 the third.
.sprite_dest
{
    ZA_AUTO1 lo
    ZA_AUTO1 hi
    LDA spr_col : CLC : ADC spr_i
    CMP #32 : BCS wrapped
    STA dst_col : STA dst_acol
    LDA spr_line : STA dst_line
    LSR A : LSR A : LSR A : STA dst_arow
    RTS
.wrapped
    \ hi = 8 * the third + the line; lo = 32 * the row in the third + the
    \ column (+ i), carrying into hi.
    PHA
    LDA spr_line : AND #&C0 : LSR A : LSR A : LSR A : STA hi
    LDA spr_line : AND #7 : ORA hi : STA hi
    LDA spr_line : AND #&38 : ASL A : ASL A : STA lo
    PLA : CLC : ADC lo : STA lo
    LDA hi : ADC #0 : STA hi
    LDA lo : AND #31 : STA dst_col : STA dst_acol
    LDA hi : AND #&18 : STA dst_arow        ; 8 * the third
    LDA lo : LSR A : LSR A : LSR A : LSR A : LSR A : ORA dst_arow : STA dst_arow
    \ dst_line = 64 * the third + 8 * the row + the line
    ASL A : ASL A : ASL A : STA dst_line
    LDA hi : AND #7 : ORA dst_line : STA dst_line
    LDA hi : CMP #&18 : BCC done
    \ Past the bitmap, into the Spectrum's attributes: nothing the port's
    \ screen holds (the original's limits keep its sprites from it).
.past
    JMP past
.done
    RTS
}

\ The attribute of cell dst_arow, dst_acol changed by the mode.
.sprite_attr
{
    LDA dst_arow : LDX dst_acol : JSR attr_at
    LDY #0 : LDA (attr_ptr),Y
    LDX spr_mode : BEQ mode0
    DEX : BEQ mode1
    \ Mode 2: PO-ATTR, (old AND MASK_T) OR (ATTR_T AND NOT MASK_T).
    AND mask_t : STA (attr_ptr),Y
    LDA mask_t : EOR #&FF : AND attr_t
    ORA (attr_ptr),Y : STA (attr_ptr),Y
    RTS
.mode0
    CMP attr_p : BNE done
    LDA spr_attr : STA (attr_ptr),Y
    RTS
.mode1
    CMP spr_attr : BNE done
    LDA attr_p : STA (attr_ptr),Y
.done
    RTS
}

\ XOR cell spr_i's byte of spr_buf onto line dst_line, column dst_col,
\ coloured as the head of the file says.
.sprite_byte
{
    \ The cell: its screen address and scenery (the calls first: then the
    \ fb_ values, which their locals may share)...
    LDA dst_line : LSR A : LSR A : LSR A : LDX dst_col : JSR cell_at
    JSR cell_info : STA fb_home
    LDA dst_line : AND #7 : TAY
    LDA (cell_bg),Y : STA fb_glyph
    TYA : ORA cell_scr : STA fb_scr
    LDA cell_scr+1 : STA fb_scr+1
    \ ... and the sprite's colour there (ink_for touches only ink_mask).
    LDX spr_ink
    LDA spr_door : BEQ not_door
    LDY #0 : LDA (attr_ptr),Y : AND #7 : TAX    ; (the door's: its cell's ink)
.not_door
    LDA dst_line : LSR A : LSR A : LSR A : JSR ink_for
    LDA ink_mask : STA fb_own
    LDX spr_i : LDA spr_buf,X : STA fb_bits
}
\ XOR the byte fb_bits onto the cell's line at fb_scr (its left half, then
\ its right, 8 on), over scenery fb_glyph in fb_home, the sprite in fb_own.
.sprite_halves
{
    ZA_AUTO1 bits                   ; the sprite's 4 pixels in this half
    ZA_AUTO1 bg                     ; the scenery's 4 pixels
    ZA_AUTO1 lit                    ; the screen's lit pixels before
    ZA_AUTO1 new                    ; the pixels the XOR lights
    ZA_AUTO1 out
    LDA fb_bits : BEQ done          ; (nothing to XOR)
    LSR A : LSR A : LSR A : LSR A : BEQ right
    STA bits
    LDA fb_glyph : LSR A : LSR A : LSR A : LSR A : STA bg
    JSR half                        ; the left four pixels
.right
    LDA fb_bits : AND #15 : BEQ done
    STA bits
    LDA fb_scr : ORA #8 : STA fb_scr
    LDA fb_glyph : AND #15 : STA bg
    \ Fall into half: the right four.
.half
    LDY #0
    LDA (fb_scr),Y : BNE busy
    \ Nothing lit there: the sprite's pixels light in its colour, or the
    \ scenery's where the scenery has them.
    LDX bits
    LDA bg : BNE some
    LDA spread,X : AND fb_own
    STA (fb_scr),Y
.done
    RTS
.some
    LDA #0                          ; (the general way, nothing lit)
.busy
    TAX : LDA lit_nib,X : STA lit
    \ What stays lit keeps its colour.
    LDA bits : EOR #15 : AND lit : TAX
    LDA spread,X : AND (fb_scr),Y : STA out
    \ What the XOR lights: the scenery's colour, or the sprite's.
    LDA lit : EOR #15 : AND bits : STA new
    AND bg : TAX
    LDA spread,X : AND fb_home : ORA out : STA out
    LDA bg : EOR #15 : AND new : TAX
    LDA spread,X : AND fb_own : ORA out
    STA (fb_scr),Y
    RTS
}
\ A MODE 1 byte's 4 pixels, lit (non-zero) or not, as a nibble (the
\ leftmost in bit 3).
.lit_nib
FOR b = 0..255
    EQUB ((b >> 4) OR b) AND 15
NEXT
ZA_AUTO2 fb_scr                 ; sprite_halves' cell line
ZA_AUTO1 fb_bits
ZA_AUTO1 fb_glyph
ZA_AUTO1 fb_home
ZA_AUTO1 fb_own

\ --- The fast path: a row's cells all in its character row ----------------
\ For each cell of character row spr_crow (columns spr_col on): its
\ attribute changed by the mode (once a character row: the modes are
\ idempotent), its screen address, its scenery's glyph and colour, and
\ the sprite's colour there.
.sprite_cache
{
    LDA #0 : STA spr_i
.cell
    LDA spr_col : CLC : ADC spr_i : STA dst_acol : STA dst_col
    LDA spr_crow : STA dst_arow
    JSR sprite_attr
    LDA spr_crow : LDX spr_i : PHA
    LDX spr_ink : JSR ink_for
    LDX spr_i : LDA ink_mask : STA sc_own,X
    PLA : LDX dst_col : JSR cell_at
    LDX spr_door : BEQ not_door
    LDY #0 : LDA (attr_ptr),Y : AND #7 : TAX
    LDA spr_crow : JSR ink_for
    LDX spr_i : LDA ink_mask : STA sc_own,X
.not_door
    JSR cell_info
    LDX spr_i : STA sc_home,X
    LDA cell_bg : STA sc_bglo,X : LDA cell_bg+1 : STA sc_bghi,X
    LDA cell_scr : STA sc_lo,X : LDA cell_scr+1 : STA sc_hi,X
    INC spr_i : LDA spr_i : CMP spr_cells : BNE cell
    RTS
}

\ XOR the row in spr_buf onto line spr_line through the cache.
.sprite_fast_row
{
    ZA_AUTO2 bgp
    LDA #0 : STA spr_i
.cell
    LDX spr_i
    LDA sc_home,X : STA fb_home
    LDA sc_own,X : STA fb_own
    LDA sc_bglo,X : STA bgp : LDA sc_bghi,X : STA bgp+1
    LDA spr_line : AND #7 : TAY
    LDA (bgp),Y : STA fb_glyph
    TYA : ORA sc_lo,X : STA fb_scr
    LDA sc_hi,X : STA fb_scr+1
    LDA spr_buf,X : STA fb_bits
    JSR sprite_halves
    INC spr_i : LDA spr_i : CMP spr_cells : BNE cell
    RTS
}
.sc_lo      SKIP SPR_MAX_W + 1
.sc_hi      SKIP SPR_MAX_W + 1
.sc_home    SKIP SPR_MAX_W + 1
.sc_own     SKIP SPR_MAX_W + 1
.sc_bglo    SKIP SPR_MAX_W + 1
.sc_bghi    SKIP SPR_MAX_W + 1
