\ ***************************************************************************
\ SPRITE: the compiler library's sprite routine (25431,
\ docs/research/runtime.md), without its colour clash (decision 5). A
\ parameter block (sprite_blocks, eight of 8 bytes, as the original's at
\ 24759) gives the graphic's address (the original's), x, y in PLOT
\ coordinates (175 the top line), rows, width in bytes, an attribute mode
\ and an attribute. Each pixel row XORs onto the screen, unmasked; before
\ it, the attributes of the cells it covers change by the mode:
\
\   0: a cell still ATTR_P takes the block's attribute (draw underground)
\   1: a cell with the block's attribute goes back to ATTR_P (its erase)
\   2: the cell takes the print colours, (old AND MASK_T) OR (ATTR_T AND
\      NOT MASK_T), as the ROM's PO-ATTR (outdoors)
\
\ The attributes are kept exactly (`attrs`: the game logic reads them),
\ and the screen's lit and unlit pixels are exactly the original's (the
\ logic's POINT reads them). Only the colours differ: a pixel the XOR
\ lights takes the scenery's colour if the scenery has it lit (the cell's
\ glyph, cell_info) and the sprite's colour if not; a lit pixel the XOR
\ leaves lit keeps its colour.
\
\ Nothing clips: a row running past column 31 carries on where the
\ Spectrum's screen address + i goes, and its attribute where the
\ original's derives it from that address (sprite_dest).
\ ***************************************************************************

SPR_MAX_W = 4                   ; the widest graphic (the door's 4 bytes)
\ The doors' frames, by the original's address: door_gfx32's (52300, 4
\ frames of 32 x 4 bytes) and door_gfx24's (53532, 4 of 24 x 2).
DOOR_FROM = {52300, 53532}
DOOR_TO   = {52300 + 4 * 128, 53532 + 4 * 48}

ZA_AUTO2 spr_gfx                ; the graphic's next row
ZA_AUTO1 spr_line               ; the screen line of the next row (175 - y)
ZA_AUTO1 spr_rows
ZA_AUTO1 spr_w
ZA_AUTO1 spr_mode
ZA_AUTO1 spr_attr
ZA_AUTO1 spr_ink                ; the sprite's own colour, a Spectrum ink
ZA_AUTO1 spr_door               ; a door: its own colour is its cell's
ZA_AUTO1 spr_fast               ; no row runs past column 31: sprite_segment's way
ZA_AUTO1 spr_crow               ; sprite_segment's character row
ZA_AUTO1 spr_shift              ; x MOD 8
ZA_AUTO1 spr_col                ; x DIV 8
ZA_AUTO1 spr_cells              ; cells a row covers: w, or w + 1 shifted
ZA_AUTO1 spr_i
ZA_AUTO1 dst_line               ; sprite_dest's: where cell i of the row goes
ZA_AUTO1 dst_col
ZA_AUTO1 dst_arow               ; ... and the attribute it changes
ZA_AUTO1 dst_acol

\ Draw sprite block X (0-7).
.sprite
{
    TXA : ASL A : ASL A : ASL A : TAX
    LDA sprite_blocks,X : STA spr_gfx
    LDA sprite_blocks+1,X : STA spr_gfx+1
    LDA sprite_blocks+2,X : PHA
    LDA #175 : SEC : SBC sprite_blocks+3,X : STA spr_line
    LDA sprite_blocks+4,X : STA spr_rows
    LDA sprite_blocks+5,X : STA spr_w
    LDA sprite_blocks+6,X : STA spr_mode
    LDA sprite_blocks+7,X : STA spr_attr
    \ The doors' graphics are scenery (decision 5): their pixels take the
    \ colour the original shows them in, their cell's ink.
    LDX #0 : STX spr_door : STX spr_fast
.door
    LDA spr_gfx : CMP door_from_lo,X
    LDA spr_gfx+1 : SBC door_from_hi,X : BCC next_door   ; below its start
    LDA spr_gfx : CMP door_to_lo,X
    LDA spr_gfx+1 : SBC door_to_hi,X : BCS next_door     ; at or past its end
    INC spr_door
.next_door
    INX : CPX #2 : BNE door
    JSR sprite_gfx
    PLA : PHA : AND #7 : STA spr_shift
    CMP #1                          ; (C set if shifted: one more cell)
    LDA spr_w : ADC #0 : STA spr_cells
    PLA : LSR A : LSR A : LSR A : STA spr_col
    \ The sprite's colour: the ink its mode would give a cell.
    LDA spr_attr
    LDX spr_mode : BEQ ink
    LDA attr_p
    DEX : BEQ ink
    LDA attr_t
.ink
    AND #7 : STA spr_ink
    LDA spr_rows : BEQ done
    \ Rows that stay in columns 0-31 (as good as all): each cell's place,
    \ scenery and colours are its character row's, worked out once.
    LDA spr_col : CLC : ADC spr_cells
    CMP #33 : BCS row
    LDA #1 : STA spr_fast
.row
    LDA spr_fast : BEQ slow
    JSR sprite_segment              ; (the rows to the character row's end)
    LDA spr_rows : BNE row
    RTS
.slow
    JSR sprite_shift
    LDA #0 : STA spr_i
.cell
    JSR sprite_dest
    JSR sprite_attr
    JSR sprite_byte
    INC spr_i : LDA spr_i : CMP spr_cells : BNE cell
.row_done
    INC spr_line
    LDA spr_gfx : CLC : ADC spr_w : STA spr_gfx
    BCC next : INC spr_gfx+1
.next
    DEC spr_rows : BNE row
.done
    RTS
}

\ X = ink X (A kept), unless it's black: a lit pixel can't be black on the BBC (its
\ lit pixels must be the original's), so black takes ATTR_T's ink, or
\ white (decision 5: the first monster, drawn before its mode is ever
\ set, in mode 0 with attribute 0).
.own_ink
{
    CPX #0 : BNE done
    PHA
    LDA attr_t : AND #7 : BNE ok
    LDA #7
.ok TAX
    PLA
.done
    RTS
}

\ spr_gfx: the original's address of the graphic, made the port's (the
\ regions of tools/mkdata.py's sprites.bin, one after another).
.sprite_gfx
{
    LDX #0
.region
    LDA spr_gfx : CMP region_from_lo,X
    LDA spr_gfx+1 : SBC region_from_hi,X : BCC next     ; below its start
    LDA spr_gfx : CMP region_to_lo,X
    LDA spr_gfx+1 : SBC region_to_hi,X : BCS next       ; at or past its end
    LDA spr_gfx : CLC : ADC region_add_lo,X : STA spr_gfx
    LDA spr_gfx+1 : ADC region_add_hi,X : STA spr_gfx+1
    RTS
.next
    INX : CPX #SPR_REGIONS : BNE region
.none
    JMP none                        ; (no graphic there: the original has none)
}
\ The regions and where each starts in sprites.bin (tools/mkdata.py).
INCLUDE "../build/data/sprmap.6502"
SPR_START = sprites + SPR_AT
.door_from_lo   EQUB LO(DOOR_FROM[0]), LO(DOOR_FROM[1])
.door_from_hi   EQUB HI(DOOR_FROM[0]), HI(DOOR_FROM[1])
.door_to_lo     EQUB LO(DOOR_TO[0]), LO(DOOR_TO[1])
.door_to_hi     EQUB HI(DOOR_TO[0]), HI(DOOR_TO[1])
.region_from_lo
FOR n = 0..SPR_REGIONS-1 : EQUB LO(SPR_FROM[n]) : NEXT
.region_from_hi
FOR n = 0..SPR_REGIONS-1 : EQUB HI(SPR_FROM[n]) : NEXT
.region_to_lo
FOR n = 0..SPR_REGIONS-1 : EQUB LO(SPR_TO[n]) : NEXT
.region_to_hi
FOR n = 0..SPR_REGIONS-1 : EQUB HI(SPR_TO[n]) : NEXT
.region_add_lo
FOR n = 0..SPR_REGIONS-1 : EQUB LO(SPR_START[n] - SPR_FROM[n]) : NEXT
.region_add_hi
FOR n = 0..SPR_REGIONS-1 : EQUB HI(SPR_START[n] - SPR_FROM[n]) : NEXT

\ The graphic's row into spr_buf, shifted right by spr_shift: spr_cells
\ bytes. A shift of 5 to 7 is done as one left of 8 less it, with the
\ row a byte along: the same bytes (the row with a zero byte after it,
\ shifted right by s, is the row with one before it shifted left by 8 - s),
\ in at most 4 shifts.
.sprite_shift
{
    LDA #0
    FOR n = 0..SPR_MAX_W
        STA spr_buf + n
    NEXT
    LDA spr_shift : CMP #5 : BCS left
    LDY spr_w : DEY
.copy
    LDA (spr_gfx),Y : STA spr_buf,Y
    DEY : BPL copy
    LDX spr_shift : BEQ done
.right
    LSR spr_buf
    FOR n = 1..SPR_MAX_W
        ROR spr_buf + n
    NEXT
    DEX : BNE right
.done
    RTS
.left
    LDY spr_w : DEY
.copy1
    LDA (spr_gfx),Y : STA spr_buf+1,Y
    DEY : BPL copy1
    LDA #8 : SEC : SBC spr_shift : TAX
.shl
    ASL spr_buf + SPR_MAX_W
    FOR n = SPR_MAX_W-1..0
        ROL spr_buf + n
    NEXT
    DEX : BNE shl
    RTS
}
.spr_buf    SKIP SPR_MAX_W + 1

\ Where cell spr_i of the row on spr_line goes: the Spectrum's screen
\ address of (spr_line, spr_col) plus spr_i, as dst_line, dst_col, and
\ the attribute the original derives from that address (its low byte
\ with the third from the high byte), dst_arow, dst_acol. Past column
\ 31 the address's low byte carries into the character row in the third,
\ and from the third's last row into the high byte: the pixel line, and
\ from line 7 the third.
.sprite_dest
{
    ZA_AUTO1 lo
    ZA_AUTO1 hi
    LDA spr_col : CLC : ADC spr_i
    CMP #32 : BCS wrapped
    STA dst_col : STA dst_acol
    LDA spr_line : STA dst_line
    LSR A : LSR A : LSR A : STA dst_arow
    RTS
.wrapped
    \ hi = 8 * the third + the line; lo = 32 * the row in the third + the
    \ column (+ i), carrying into hi.
    PHA
    LDA spr_line : AND #&C0 : LSR A : LSR A : LSR A : STA hi
    LDA spr_line : AND #7 : ORA hi : STA hi
    LDA spr_line : AND #&38 : ASL A : ASL A : STA lo
    PLA : CLC : ADC lo : STA lo
    LDA hi : ADC #0 : STA hi
    LDA lo : AND #31 : STA dst_col : STA dst_acol
    LDA hi : AND #&18 : STA dst_arow        ; 8 * the third
    LDA lo : LSR A : LSR A : LSR A : LSR A : LSR A : ORA dst_arow : STA dst_arow
    \ dst_line = 64 * the third + 8 * the row + the line
    ASL A : ASL A : ASL A : STA dst_line
    LDA hi : AND #7 : ORA dst_line : STA dst_line
    LDA hi : CMP #&18 : BCC done
    \ Past the bitmap, into the Spectrum's attributes: nothing the port's
    \ screen holds (the original's limits keep its sprites from it).
.past
    JMP past
.done
    RTS
}

\ The attribute of cell dst_arow, dst_acol changed by the mode.
.sprite_attr
{
    LDA dst_arow : LDX dst_acol : JSR attr_at
    LDY #0 : LDA (attr_ptr),Y
    LDX spr_mode : BEQ mode0
    DEX : BEQ mode1
    \ Mode 2: PO-ATTR, (old AND MASK_T) OR (ATTR_T AND NOT MASK_T).
    AND mask_t : STA (attr_ptr),Y
    LDA mask_t : EOR #&FF : AND attr_t
    ORA (attr_ptr),Y : STA (attr_ptr),Y
    RTS
.mode0
    CMP attr_p : BNE done
    LDA spr_attr : STA (attr_ptr),Y
    RTS
.mode1
    CMP spr_attr : BNE done
    LDA attr_p : STA (attr_ptr),Y
.done
    RTS
}

\ XOR cell spr_i's byte of spr_buf onto line dst_line, column dst_col,
\ coloured as the head of the file says.
.sprite_byte
{
    \ The cell: its screen address and scenery (the calls first: then the
    \ fb_ values, which their locals may share)...
    LDA dst_line : LSR A : LSR A : LSR A : LDX dst_col : JSR cell_at
    JSR cell_info : STA fb_home
    LDA dst_line : AND #7 : TAY
    LDA (cell_bg),Y : STA fb_glyph
    TYA : ORA cell_scr : STA fb_scr
    LDA cell_scr+1 : STA fb_scr+1
    \ ... and the sprite's colour there (ink_for touches only ink_mask).
    LDX spr_ink
    LDA spr_door : BEQ not_door
    LDY #0 : LDA (attr_ptr),Y : AND #7 : TAX    ; (the door's: its cell's ink)
.not_door
    JSR own_ink
    LDA dst_line : LSR A : LSR A : LSR A : JSR ink_for
    LDA ink_mask : STA fb_own
    LDX spr_i : LDA spr_buf,X : STA fb_bits
}
\ XOR the byte fb_bits onto the cell's line at fb_scr (its left half, then
\ its right, 8 on), over scenery fb_glyph in fb_home, the sprite in fb_own.
.sprite_halves
{
    ZA_AUTO1 bg                     ; the scenery's 4 pixels
    ZA_AUTO1 lit                    ; the screen's lit pixels before
    ZA_AUTO1 new                    ; the pixels the XOR lights
    ZA_AUTO1 out
    LDA fb_bits : BEQ done          ; (nothing to XOR)
    LSR A : LSR A : LSR A : LSR A : BEQ right
    STA bits
    LDA fb_glyph : LSR A : LSR A : LSR A : LSR A : STA bg
    JSR half                        ; the left four pixels
.right
    LDA fb_bits : AND #15 : BEQ done
    STA bits
    LDA fb_scr : ORA #8 : STA fb_scr
    LDA fb_glyph : AND #15 : STA bg
    \ Fall into half: the right four.
.half
    LDY #0
    LDA (fb_scr),Y : BNE busy
    \ Nothing lit there: the sprite's pixels light in its colour, or the
    \ scenery's where the scenery has them.
    LDX bits
    LDA bg : BNE some
    LDA spread,X : AND fb_own
    STA (fb_scr),Y
.done
    RTS
.some
    LDA #0                          ; (the general way, nothing lit)
.busy
    TAX : LDA nlit,X : AND #15 : EOR #15 : STA lit    ; (its lit pixels)
    \ What stays lit keeps its colour.
    LDA bits : EOR #15 : AND lit : TAX
    LDA spread,X : AND (fb_scr),Y : STA out
    \ What the XOR lights: the scenery's colour, or the sprite's.
    LDA lit : EOR #15 : AND bits : STA new
    AND bg : TAX
    LDA spread,X : AND fb_home : ORA out : STA out
    LDA bg : EOR #15 : AND new : TAX
    LDA spread,X : AND fb_own : ORA out
    STA (fb_scr),Y
    RTS
}
ZA_AUTO2 fb_scr                 ; sprite_halves' cell line
ZA_AUTO1 fb_bits
ZA_AUTO1 fb_glyph
ZA_AUTO1 fb_home
ZA_AUTO1 fb_own

\ --- The fast path: a row's cells all in its character row ----------------
\ The fast path a character row at a time: the rows from spr_line to the
\ character row's end (or the sprite's), each shifted into seg_buf, the
\ cells' attributes once, then each cell down its lines. Moves
\ spr_line, spr_gfx and spr_rows on.
.sprite_segment
{
    ZA_AUTO2 bgp
    ZA_AUTO1 first                  ; the segment's first line in its cell (0-7)
    ZA_AUTO1 last                   ; ... and one past its last
    ZA_AUTO2 scr                    ; the cell's line 0, its left half
    ZA_AUTO2 scr8                   ; ... its right
    ZA_AUTO1 sbyte                  ; the sprite's byte on this line
    ZA_AUTO1 scene                  ; the scenery's
    ZA_AUTO1 bm                     ; B: the half's sprite pixels, spread
    ZA_AUTO1 m                      ; M: the colour they light in
    ZA_AUTO1 own
    ZA_AUTO1 ho
    ZA_AUTO2 homep                  ; the cells' CELL_HOME, CELL_GLYPH_LO and _HI,
    ZA_AUTO2 glop                   ; ... indexed by the cell (attr_ptr's too)
    ZA_AUTO2 ghip
    ZA_AUTO1 seg_own                ; the sprite's colour byte in this row
    ZA_AUTO1 t2
    \ The row's first cell: its attribute and screen addresses, and its
    \ entries in the cell tables at the same offset as its attribute. The
    \ fast path's cells don't wrap: the rest follow, a cell on.
    LDA spr_line : LSR A : LSR A : LSR A : STA spr_crow
    LDX spr_col : JSR cell_at
    LDA attr_ptr : STA homep : STA glop : STA ghip
    LDA attr_ptr+1 : CLC : ADC #HI(CELL_HOME) - HI(attrs) : STA homep+1
    LDA attr_ptr+1 : CLC : ADC #HI(CELL_GLYPH_LO) - HI(attrs) : STA glop+1
    LDA attr_ptr+1 : CLC : ADC #HI(CELL_GLYPH_HI) - HI(attrs) : STA ghip+1
    LDA cell_scr : STA scr : LDA cell_scr+1 : STA scr+1
    \ The cells' attributes, by the mode (as sprite_attr), before any
    \ colour is read from them (the doors').
    LDA mask_t : EOR #&FF : AND attr_t : STA t2
    LDY #0
.attr
    LDA (attr_ptr),Y
    LDX spr_mode : BEQ mode0
    DEX : BEQ mode1
    AND mask_t : ORA t2 : STA (attr_ptr),Y      ; mode 2: PO-ATTR
    JMP attr_next
.mode0
    CMP attr_p : BNE attr_next
    LDA spr_attr : STA (attr_ptr),Y
    JMP attr_next
.mode1
    CMP spr_attr : BNE attr_next
    LDA attr_p : STA (attr_ptr),Y
.attr_next
    INY : CPY spr_cells : BNE attr
    \ The sprite's own colour in this row (a door's is each cell's, below).
    LDX spr_ink : JSR own_ink
    LDA spr_crow : JSR ink_for
    LDA ink_mask : STA seg_own
    LDA spr_line : AND #7 : STA first
    \ last = first + the rows, at most 8
    CLC : ADC spr_rows : CMP #9 : BCC fits
    LDA #8
.fits
    STA last
    \ The rows, shifted, into seg_buf by column: cell i's line y at 8i + y.
    LDX spr_shift
    LDA seg_shift_lo,X : STA seg_row.rjump+1 : STA seg_row.ljump+1
    LDA seg_shift_hi,X : STA seg_row.rjump+2 : STA seg_row.ljump+2
    LDA last : STA seg_row.stop
    LDA first : JSR seg_row
    \ Each cell, down its lines, Y the line in the cell. Per half-line,
    \ with S the screen byte, B the sprite's 4 pixels spread and M the
    \ colour the pixels it lights take (the scenery's, home, where the
    \ scenery's lit, the sprite's own where not):
    \   S' = S EOR (B AND (S OR (M AND nlit[S])))
    \ the pixels B leaves alone stay, those it toggles that were lit go,
    \ those it toggles that weren't take M.
    LDA #0 : STA spr_i
.cell
    LDA seg_own
    LDX spr_door : BEQ own_set
    LDY spr_i : LDA (attr_ptr),Y : AND #7 : TAX : JSR own_ink
    LDA spr_crow : JSR ink_for
    LDA ink_mask
.own_set
    STA own
    LDY spr_i
    EOR (homep),Y : STA ho          ; M = own EOR (glyph's pixels AND ho)
    LDA (glop),Y : STA bgp : LDA (ghip),Y : STA bgp+1
    LDA scr : ORA #8 : STA scr8     ; (the right half: line + 8)
    LDA scr+1 : STA scr8+1
    TYA : ASL A : ASL A : ASL A : CLC : ADC #LO(seg_buf) : STA column+1 : STA pcol+1 : STA pcol2+1
    LDA #HI(seg_buf) : ADC #0 : STA column+2 : STA pcol+2 : STA pcol2+2
    \ M is own throughout when the scenery's colour is the sprite's, or
    \ the cell has no scenery (draw_cell notes an empty glyph as
    \ blank_glyph): the plain loop.
    LDY first
    LDA ho : BEQ plain
    LDA bgp+1 : CMP #HI(blank_glyph) : BNE line
    LDA bgp : CMP #LO(blank_glyph) : BNE line
.plain
    JMP pline
.line
.column
    LDA seg_buf,Y : BEQ next_line   ; (self-modified: this cell's column)
    STA sbyte
    LDA (bgp),Y : STA scene
    LDX sbyte : LDA hi_spread,X : BEQ right
    STA bm
    LDX scene : LDA hi_spread,X : AND ho : EOR own : STA m
    LDA (scr),Y : BEQ left_empty
    TAX : LDA nlit,X : AND m : ORA (scr),Y : AND bm : EOR (scr),Y : STA (scr),Y
.right
    LDX sbyte : LDA lo_spread,X : BEQ next_line
    STA bm
    LDX scene : LDA lo_spread,X : AND ho : EOR own : STA m
    LDA (scr8),Y : BEQ right_empty
    TAX : LDA nlit,X : AND m : ORA (scr8),Y : AND bm : EOR (scr8),Y : STA (scr8),Y
.next_line
    INY : CPY last : BEQ cell_done
    JMP line
.cell_done
    LDA scr : CLC : ADC #16 : STA scr   ; (the next cell's screen)
    BCC scr_same : INC scr+1
.scr_same
    INC spr_i : LDA spr_i : CMP spr_cells : BEQ segment_done
    JMP cell
.segment_done
    \ On past the segment.
    LDA last : SEC : SBC first
    PHA : CLC : ADC spr_line : STA spr_line
    PLA : EOR #&FF : SEC : ADC spr_rows : STA spr_rows
    RTS
    \ An empty byte: the toggled pixels all take M.
.left_empty
    LDA bm : AND m : STA (scr),Y
    JMP right
.right_empty
    LDA bm : AND m : STA (scr8),Y
    JMP next_line
    \ The plain loop: as `line`, M being own.
.pline
.pcol
    LDX seg_buf,Y : BEQ pnext       ; (self-modified: this cell's column)
    LDA hi_spread,X : BEQ pright
    STA bm
    LDA (scr),Y : BEQ pl_empty
    TAX : LDA nlit,X : AND own : ORA (scr),Y : AND bm : EOR (scr),Y : STA (scr),Y
.pcol2
    LDX seg_buf,Y                   ; (self-modified: as pcol)
.pright
    LDA lo_spread,X : BEQ pnext
    STA bm
    LDA (scr8),Y : BEQ pr_empty
    TAX : LDA nlit,X : AND own : ORA (scr8),Y : AND bm : EOR (scr8),Y : STA (scr8),Y
.pnext
    INY : CPY last : BNE pline
    JMP cell_done
.pl_empty
    LDA bm : AND own : STA (scr),Y
    JMP pright                      ; (X still the sprite's byte)
.pr_empty
    LDA bm : AND own : STA (scr8),Y
    JMP pnext
}
.seg_buf    SKIP 8 * (SPR_MAX_W + 1)

\ The segment's rows at spr_gfx, lines A to stop in the cell, shifted
\ right by spr_shift into seg_buf, a cell's line y at 8 * the cell + y,
\ as sprite_shift does it: a byte at a time in A, the bits it pushes out
\ kept in t for the next cell. Shifts 1-4 go right through a chain of
\ LSR A : ROR t entered at the shift's length, 5-7 left by 8 less
\ (ASL A : ROL t), the jumps set per segment (rjump, ljump). spr_gfx
\ goes on past the rows.
.seg_row
{
    ZA_AUTO1 stop                   ; one past the last line

    ZA_AUTO1 t
    ZA_AUTO1 prev                   ; the bits the last byte left for this cell
    ZA_AUTO1 a_next
    ZA_AUTO1 line                   ; the row's line in the cell
    ZA_AUTO1 row_end                ; Y past the row's last byte
    STA line
    LDY #0
    LDA spr_shift : BNE shifted
    JMP plain
.shifted
    CMP #5 : BCS left
.rrow
    LDX line
    LDA #0 : STA prev
    TYA : CLC : ADC spr_w : STA row_end
.rbyte
    LDA #0 : STA t
    LDA (spr_gfx),Y
.rjump
    JMP r4                          ; (self-modified: the shift's entry)
    ZA_CANJUMP r1, r2, r3, r4
.r4 LSR A : ROR t
.r3 LSR A : ROR t
.r2 LSR A : ROR t
.r1 LSR A : ROR t
    ORA prev : STA seg_buf,X
    LDA t : STA prev
    TXA : CLC : ADC #8 : TAX
    INY : CPY row_end : BNE rbyte
    LDA prev : STA seg_buf,X        ; (the extra cell a shift spills into)
    INC line : LDA line : CMP stop : BNE rrow
    JMP done
.left
.lrow
    LDX line
    LDA #0 : STA prev
    TYA : CLC : ADC spr_w : STA row_end
.lbyte
    LDA #0 : STA t
    LDA (spr_gfx),Y
.ljump
    JMP l3                          ; (self-modified)
    ZA_CANJUMP l1, l2, l3
.l3 ASL A : ROL t
.l2 ASL A : ROL t
.l1 ASL A : ROL t
    STA a_next
    LDA t : ORA prev : STA seg_buf,X
    LDA a_next : STA prev
    TXA : CLC : ADC #8 : TAX
    INY : CPY row_end : BNE lbyte
    LDA prev : STA seg_buf,X
    INC line : LDA line : CMP stop : BNE lrow
    \ On past the rows: Y is their bytes.
.done
    TYA : CLC : ADC spr_gfx : STA spr_gfx
    BCC same : INC spr_gfx+1
.same
    RTS
    \ Unshifted, as most rows are: a loop for each width, X the line.
.plain
    LDX spr_w
    LDA plain_lo-1,X : STA pjump+1
    LDA plain_hi-1,X : STA pjump+2
    LDX line
.pjump
    JMP p1                          ; (self-modified: the width's loop)
    ZA_CANJUMP p1, p2, p3, p4
.p1
    LDA (spr_gfx),Y : STA seg_buf,X : INY
    INX : CPX stop : BNE p1
    JMP done
.p2
    LDA (spr_gfx),Y : STA seg_buf,X : INY
    LDA (spr_gfx),Y : STA seg_buf+8,X : INY
    INX : CPX stop : BNE p2
    JMP done
.p3
    LDA (spr_gfx),Y : STA seg_buf,X : INY
    LDA (spr_gfx),Y : STA seg_buf+8,X : INY
    LDA (spr_gfx),Y : STA seg_buf+16,X : INY
    INX : CPX stop : BNE p3
    JMP done
.p4
    LDA (spr_gfx),Y : STA seg_buf,X : INY
    LDA (spr_gfx),Y : STA seg_buf+8,X : INY
    LDA (spr_gfx),Y : STA seg_buf+16,X : INY
    LDA (spr_gfx),Y : STA seg_buf+24,X : INY
    INX : CPX stop : BNE p4
    JMP done
.plain_lo
    EQUB LO(p1), LO(p2), LO(p3), LO(p4)
.plain_hi
    EQUB HI(p1), HI(p2), HI(p3), HI(p4)
    ASSERT SPR_MAX_W = 4
}
\ seg_row's chain entry for each shift (0: none; 5-7: left by 8 less).
.seg_shift_lo
    EQUB LO(seg_row.r1), LO(seg_row.r1), LO(seg_row.r2), LO(seg_row.r3), LO(seg_row.r4), LO(seg_row.l3), LO(seg_row.l2), LO(seg_row.l1)
.seg_shift_hi
    EQUB HI(seg_row.r1), HI(seg_row.r1), HI(seg_row.r2), HI(seg_row.r3), HI(seg_row.r4), HI(seg_row.l3), HI(seg_row.l2), HI(seg_row.l1)

\ hi_spread, lo_spread (a byte's top and bottom nibbles spread into both
\ halves of a MODE 1 byte) and nlit (a MODE 1 byte's unlit pixels).
.init_sprite_tables
{
    LDX #0
.byte
    TXA : LSR A : LSR A : LSR A : LSR A : STA top : TAY
    LDA spread,Y : STA hi_spread,X
    TXA : AND #15 : TAY
    LDA spread,Y : STA lo_spread,X
    TXA : ORA top : AND #15 : EOR #15 : TAY
    LDA spread,Y : STA nlit,X
    INX : BNE byte
    RTS
}
ZA_AUTO1 top
ZA_AUTO1 bits                       ; sprite_halves': the sprite's 4 pixels in this half

