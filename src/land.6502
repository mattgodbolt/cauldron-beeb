\ ***************************************************************************
\ The landscape: rows 16-22 outdoors, 32 columns each printed from the
\ column table by the original's 57130 (docs/research/graphics.md). A
\ column id (1-255) is seven (ink, character) pairs, from font A below
\ id 216 and font B from it.
\ ***************************************************************************

LAND_ROW   = 16                 ; the landscape's first character row
LAND_ROWS  = 7
LAND_SCREENS = 61
LAND_FONT_B = 216               ; the first column id in font B
LAND_MAP   = 57310              ; the original's map: tools/mkdata.py's landmap.bin
LAND_ATTR  = &40                ; the landscape's attributes: BRIGHT, black paper

ZA_AUTO2 land_col               ; the column id's record
IF DEFINED(VIEWER)
ZA_AUTO2 land_ids               ; the 32 column ids being drawn
ZA_AUTO1 land_screen            ; ... in the colours of this screen
ENDIF

IF DEFINED(VIEWER)
\ Draw landscape screen A (0-60) into rows 16-22, and set the lower band's
\ colours to its (decision 4).
.draw_land_screen
{
    STA land_screen
    \ land_ids = landmap + 32 * the screen (up to 11 bits: every shift's carry)
    LDX #0 : STX land_ids+1
    ASL A : ASL A : ASL A : ROL land_ids+1 : ASL A : ROL land_ids+1 : ASL A : ROL land_ids+1
    ADC #LO(landmap) : STA land_ids
    LDA land_ids+1 : ADC #HI(landmap) : STA land_ids+1
    JMP draw_land
}
ENDIF

\ The lower band's colours, landscape screen A's (decision 3).
.land_colours
{
    PHA
    \ Its map, landpal + 8 * the screen.
    LDX #0 : STX cmap_src+1
    ASL A : ASL A : ASL A : ROL cmap_src+1      ; (8 * 60 < 512)
    ADC #LO(landpal) : STA cmap_src
    LDA cmap_src+1 : ADC #HI(landpal) : STA cmap_src+1
    JSR set_lower_cmap
    \ Its colours: 2 bytes a screen after the maps, logical 1's and 3's.
    PLA : ASL A : TAY                           ; (2 * 60 < 256)
    LDX landpal + 8 * LAND_SCREENS + 1,Y
    LDA landpal + 8 * LAND_SCREENS,Y
    SEC : JMP set_lower_palette
}

IF DEFINED(VIEWER)
\ Draw the 32 columns at land_ids in landscape screen land_screen's
\ colours, as the original prints them under BRIGHT (the viewer's: the
\ game prints them through PRINT, scroll.6502).
.draw_land
{
    ZA_AUTO1 col
    ZA_AUTO1 row
    LDA land_screen : JSR land_colours
    LDA #0 : STA col
.column
    LDY col : LDA (land_ids),Y : TAY
    LDA landcol_lo,Y : STA land_col
    LDA landcol_hi,Y : STA land_col+1
    \ The font: A below LAND_FONT_B, B from it (patched into font_add).
    LDX #0
    CPY #LAND_FONT_B : BCC fa
    INX
.fa LDA land_font_lo,X : STA font_add+1
    LDA land_font_hi,X : STA font_hi_add+1
    LDA #0 : STA row
.cell
    LDA row : ASL A : TAY
    LDA (land_col),Y : AND #7 : TAX     ; the ink
    LDA row : CLC : ADC #LAND_ROW : JSR ink_for
    \ The attribute, as the original prints it (BRIGHT, black paper).
    LDA (land_col),Y : AND #7 : ORA #LAND_ATTR : PHA
    INY : LDA (land_col),Y              ; the character
    LDX #0 : STX glyph+1
    ASL A : ROL glyph+1 : ASL A : ROL glyph+1 : ASL A : ROL glyph+1
    CLC
.font_add
    ADC #0 : STA glyph
    LDA glyph+1
.font_hi_add
    ADC #0 : STA glyph+1
    LDA row : CLC : ADC #LAND_ROW
    LDX col : JSR cell_at
    PLA : JSR set_attr
    JSR draw_cell
    INC row : LDA row : CMP #LAND_ROWS : BNE cell
    INC col : LDA col : CMP #32 : BNE column
    RTS
}
ENDIF

\ Glyph c of font A is at landfont + 8c - 256, of font B at + 8c + 512.
.land_font_lo
    EQUB LO(landfont - 256), LO(landfont + 512)
.land_font_hi
    EQUB HI(landfont - 256), HI(landfont + 512)

\ Each column id's record, landcols + 14 * (id - 1).
.landcol_lo
FOR i = 0..255
    EQUB LO(landcols + 14 * (i - 1))
NEXT
.landcol_hi
FOR i = 0..255
    EQUB HI(landcols + 14 * (i - 1))
NEXT
