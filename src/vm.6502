\ ***************************************************************************
\ The interpreter of the compiled BASIC (tools/bas2vm.py, decision 10).
\
\ A stack of 16-bit words (vs_lo, vs_hi, from the top at vsp), the
\ original's operators with the original's library's semantics
\ (basrt.6502), and the original's memory as the original addresses it:
\ PEEK, POKE, DPEEK and DPOKE translate their address (vm_xlat), while
\ the variables, the system variables and the sprite blocks have short
\ forms the compiler uses for constant addresses. vpc is the next
\ bytecode; GOSUB keeps the return's on the 6502's stack.
\ ***************************************************************************

\ Run the bytecode from vpc, for ever (the program never ends).
.vm_run
.vm_next
{
IF DEFINED(VMBRK)
    \ The tests' statement breakpoint: vm_hit when vpc reaches vm_brk.
    LDA vpc : CMP vm_brk : BNE go
    LDA vpc+1 : CMP vm_brk+1 : BNE go
    JSR vm_hit
.go
ENDIF
    LDY #0 : LDA (vpc),Y
    INC vpc : BNE same : INC vpc+1
.same
    ASL A : STA dispatch+1          ; (the table is a page's: 2 * the opcode)
.dispatch
    JMP (vm_table)
    INCLUDE "../build/vmjump.6502"
}

IF DEFINED(VMBRK)
.vm_hit                             ; (global: the tests' breakpoint)
    RTS
ENDIF

\ The next bytecode byte into A, in line (FETCH), or by a call (vm_byte);
\ the next word into vm_w.
MACRO FETCH
    LDY #0 : LDA (vpc),Y
    INC vpc : BNE @+ : INC vpc+1 : .@
ENDMACRO
.vm_byte
{
    LDY #0 : LDA (vpc),Y
    INC vpc : BNE same : INC vpc+1
.same
    RTS
}
.vm_word
    JSR vm_byte : STA vm_w
    JSR vm_byte : STA vm_w+1
    RTS

\ --- The stack ---------------------------------------------------------------
\ acc = the top, popped; arg likewise (POP_ACC: the same, in line).
MACRO POP_ACC
    LDX vsp
    LDA vs_lo,X : STA acc : LDA vs_hi,X : STA acc+1
    INC vsp
ENDMACRO
.pop_acc
    LDX vsp
    LDA vs_lo,X : STA acc : LDA vs_hi,X : STA acc+1
    INC vsp
    RTS
.pop_arg
    LDX vsp
    LDA vs_lo,X : STA arg : LDA vs_hi,X : STA arg+1
    INC vsp
    RTS
\ Push acc, and go on (the dispatch in line).
.push_next
    DEC vsp : LDX vsp
    LDA acc : STA vs_lo,X : LDA acc+1 : STA vs_hi,X
    LDY #0 : LDA (vpc),Y
    INC vpc : BNE push_same : INC vpc+1
.push_same
    ASL A : STA push_dispatch+1
.push_dispatch
    JMP (vm_table)
    INCLUDE "../build/vmjump.6502"
\ Push A (a byte), and go on.
.push_a_next
    STA acc : LDA #0 : STA acc+1
    JMP push_next

\ --- Constants, variables, places -------------------------------------------
.op_pushb
    FETCH : JMP push_a_next
.op_pushw
    JSR vm_word
    LDA vm_w : STA acc : LDA vm_w+1 : STA acc+1
    JMP push_next
\ The variable at bv + 2n (load) or bv + 512 + 2n (loadh).
.op_load
    FETCH : ASL A : TAY
    BCS load_high
    LDA bv,Y : STA acc : LDA bv+1,Y : STA acc+1
    JMP push_next
.load_high
    LDA bv+256,Y : STA acc : LDA bv+257,Y : STA acc+1
    JMP push_next
.op_loadh
    JSR vm_byte : ASL A : TAY
    LDA bv+512,Y : STA acc : LDA bv+513,Y : STA acc+1
    JMP push_next
.op_store
    POP_ACC
    FETCH : ASL A : TAY
    BCS store_high
    LDA acc : STA bv,Y : LDA acc+1 : STA bv+1,Y
    JMP vm_next
.store_high
    LDA acc : STA bv+256,Y : LDA acc+1 : STA bv+257,Y
    JMP vm_next
.op_storeh
    POP_ACC
    JSR vm_byte : ASL A : TAY
    LDA acc : STA bv+512,Y : LDA acc+1 : STA bv+513,Y
    JMP vm_next
\ A word or byte at a port address the compiler knew.
.op_ldw
    JSR vm_word
    LDY #0 : LDA (vm_w),Y : STA acc
    INY : LDA (vm_w),Y : STA acc+1
    JMP push_next
.op_ldb
    JSR vm_word
    LDY #0 : LDA (vm_w),Y
    JMP push_a_next
.op_stw
    JSR pop_acc
    JSR vm_word
    LDY #0 : LDA acc : STA (vm_w),Y
    INY : LDA acc+1 : STA (vm_w),Y
    JMP vm_next
.op_stb
    JSR pop_acc
    JSR vm_word
    LDY #0 : LDA acc : STA (vm_w),Y
    JMP vm_next

\ PEEK, POKE, DPEEK, DPOKE at an original address (vm_xlat): in main
\ RAM or the logic bank, in the data bank (paged in for it), or the
\ Spectrum's bitmap (made from the port's screen: PEEK only).
.op_peek
    JSR pop_acc : JSR peek_acc
    JMP push_next
\ acc = the byte at the original's address acc.
.peek_acc
{
    JSR vm_xlat
    LDA xk : BNE other
    LDY #0 : LDA (eptr),Y
.byte
    STA acc : LDA #0 : STA acc+1
    RTS
.other
    CMP #XK_DATA : BNE bitmap
    JSR page_data
    LDY #0 : LDA (eptr),Y : PHA
    JSR page_logic
    PLA : JMP byte
.bitmap
    JSR bitmap_byte
    JMP byte
}
\ POKE / DPOKE arg at the original's address acc (native code's).
.poke_at
    JSR vm_xlat
    LDA xk : BNE bad_kind
    LDY #0 : LDA arg : STA (eptr),Y
    RTS
.dpoke_at
    JSR vm_xlat
    LDA xk : BNE bad_kind
    LDY #0 : LDA arg : STA (eptr),Y
    INY : LDA arg+1 : STA (eptr),Y
    RTS
.bad_kind
    JMP vm_bad_kind
.op_dpeek
    JSR pop_acc : JSR dpeek_acc
    JMP push_next
\ acc = the word at the original's address acc (through vm_xlat).
.dpeek_acc
{
    JSR vm_xlat
    LDA xk : BNE other
    LDY #0 : LDA (eptr),Y : TAX
    INY : LDA (eptr),Y : STA acc+1 : STX acc
    RTS
.other
    CMP #XK_DATA : BNE bad
    JSR page_data
    LDY #0 : LDA (eptr),Y : TAX
    INY : LDA (eptr),Y : STA acc+1 : STX acc
    JMP page_logic
.bad
    JMP vm_bad_kind
}
.op_poke                            ; (the address on top, the value under it)
    JSR pop_acc : JSR vm_xlat
    LDA xk : BNE vm_bad_kind
    JSR pop_acc
    LDY #0 : LDA acc : STA (eptr),Y
    JMP vm_next
.op_dpoke
    POP_ACC
.dpoke_next                         ; (the address in acc, the value on top)
    JSR vm_xlat
    LDA xk : BNE vm_bad_kind
    POP_ACC
    LDY #0 : LDA acc : STA (eptr),Y
    INY : LDA acc+1 : STA (eptr),Y
    JMP vm_next
.vm_bad_kind                        ; (global: the tests stop here)
    JMP vm_bad_kind                 ; (a write the port's places don't take)

\ A of the Spectrum's bitmap byte at acc (16384-22527): its 8 pixels' lit
\ or not, from the port's screen, where they're the original's.
.bitmap_byte
{
    \ The Spectrum's address: 010 T T L L L | R R R C C C C C (T the third,
    \ L the line in the row, R the row in the third, C the column).
    LDA acc+1 : AND #&18 : ASL A : ASL A : ASL A : STA bm_line  ; 64 * the third
    LDA acc : AND #&E0 : LSR A : LSR A : ORA bm_line : STA bm_line  ; + 8 * the row
    LDA acc+1 : AND #7 : ORA bm_line : STA bm_line              ; + the line
    LDA acc : AND #31 : TAX
    LDA bm_line : LSR A : LSR A : LSR A : JSR cell_at
    LDA bm_line : AND #7 : TAY
    LDA (cell_scr),Y : JSR lit_nibble : ASL A : ASL A : ASL A : ASL A : STA bm_line
    TYA : ORA #8 : TAY
    LDA (cell_scr),Y : JSR lit_nibble : ORA bm_line
    RTS
.lit_nibble
    STA bm_tmp : LSR A : LSR A : LSR A : LSR A : ORA bm_tmp : AND #15
    RTS
}

\ An array's element's address: base + 2 * (top - 1), the base the
\ original's (the word after the opcode).
.op_elem
    JSR vm_word
    JSR pop_acc
    JSR elem_calc
    JMP push_next
\ acc = vm_w + 2 * (acc - 1): an array's element's address.
.elem_calc
{
    LDA acc : BNE lo : DEC acc+1
.lo DEC acc
    ASL acc : ROL acc+1
    CLC
    LDA acc : ADC vm_w : STA acc
    LDA acc+1 : ADC vm_w+1 : STA acc+1
    RTS
}

\ A statement compiled to native code (tools/bas2native.py): NATIVE calls
\ its routine; NIF calls an IF's, then takes the jump (the word after) if
\ it returns C set.
.op_native
    JSR vm_word
    JSR call_native
    JMP vm_next
.op_nif
{
    JSR vm_word
    JSR call_native
    PHP
    JSR vm_word
    PLP : BCC no
    LDA vm_w : STA vpc : LDA vm_w+1 : STA vpc+1
.no
    JMP vm_next
}
.call_native
    JMP (vm_w)
    INCLUDE "../build/vmnative.6502"

\ The superinstructions (tools/bas2vm.py's peephole): LDEL i, base pushes
\ array base's element by variable i (load, elem, dpeek); STEL stores the
\ top there (load, elem, dpoke); ADDB n adds a byte constant to the top.
.op_ldel
    JSR el_index
    JSR dpeek_acc
    JMP push_next
.op_stel
    JSR el_index
    JMP dpoke_next
\ acc = the element's address: the variable's index (a byte, as LOAD's),
\ then the base.
.el_index
    FETCH : ASL A : TAY
    BCS el_high
    LDA bv,Y : STA acc : LDA bv+1,Y : STA acc+1
    JMP el_base
.el_high
    LDA bv+256,Y : STA acc : LDA bv+257,Y : STA acc+1
.el_base
    JSR vm_word
    JMP elem_calc
.op_addb
{
    FETCH
    LDX vsp
    CLC : ADC vs_lo,X : STA vs_lo,X
    BCC done : INC vs_hi,X
.done
    JMP vm_next
}

\ eptr = the port's address for the original's address in acc.
.vm_xlat
{
    \ The variables first, as good as all of it: 41015-41574 to bv.
    LDA acc+1 : CMP #HI(41015) : BCC search : BNE not_low
    LDA acc : CMP #LO(41015) : BCC search
.not_low
    LDA acc+1 : CMP #HI(41575) : BCC vars : BNE search
    LDA acc : CMP #LO(41575) : BCS search
.vars
    LDA acc : CLC : ADC #LO(bv - 41015) : STA eptr
    LDA acc+1 : ADC #HI(bv - 41015) : STA eptr+1
    LDA #XK_DIRECT : STA xk
    RTS
.search
    LDX #0
.region
    LDA acc : CMP xlat_from_lo,X
    LDA acc+1 : SBC xlat_from_hi,X : BCC next
    LDA acc : CMP xlat_to_lo,X
    LDA acc+1 : SBC xlat_to_hi,X : BCS next
    LDA acc : CLC : ADC xlat_add_lo,X : STA eptr
    LDA acc+1 : ADC xlat_add_hi,X : STA eptr+1
    LDA xlat_kind,X : STA xk
    RTS
.next
    INX : CPX #XLAT_REGIONS : BNE region
    \ One of the system variables? (Each its own place.)
    LDX #XLAT_SYS - 1
.sys
    LDA acc : CMP xlat_sys_lo,X : BNE no
    LDA acc+1 : CMP xlat_sys_hi,X : BNE no
    LDA xlat_sys_plo,X : STA eptr
    LDA xlat_sys_phi,X : STA eptr+1
    LDA #XK_DIRECT : STA xk
    RTS
.no
    DEX : BPL sys
}
.vm_bad_address                     ; (global: the tests stop here)
    JMP vm_bad_address              ; (an address the port doesn't have)

\ --- Arithmetic ----------------------------------------------------------------
\ Two operands: arg = the top (the right), acc = the one under it.
.two
    LDX vsp
    LDA vs_lo,X : STA arg : LDA vs_hi,X : STA arg+1
    LDA vs_lo+1,X : STA acc : LDA vs_hi+1,X : STA acc+1
    INX : INX : STX vsp
    RTS
.op_add
    JSR two
    CLC
    LDA acc : ADC arg : STA acc
    LDA acc+1 : ADC arg+1 : STA acc+1
    JMP push_next
.op_sub
    JSR two
    SEC
    LDA acc : SBC arg : STA acc
    LDA acc+1 : SBC arg+1 : STA acc+1
    JMP push_next
.op_and
    JSR two
    LDA acc : AND arg : STA acc
    LDA acc+1 : AND arg+1 : STA acc+1
    JMP push_next
.op_or
    JSR two
    LDA acc : ORA arg : STA acc
    LDA acc+1 : ORA arg+1 : STA acc+1
    JMP push_next
.op_mul
    JSR two : JSR rt_mul
    JMP push_next
.op_div
    JSR two : JSR rt_div
    JMP push_next
.op_mod
    JSR two : JSR rt_div
    LDA arg : STA acc : LDA arg+1 : STA acc+1
    JMP push_next
\ Comparisons: 1 or 0 (rt_cmp: Z equal, C acc >= arg, signed).
.op_eq
    JSR two : JSR rt_cmp
    BEQ is_true
.is_false
    LDA #0 : JMP push_a_next
.is_true
    LDA #1 : JMP push_a_next
.op_ne
    JSR two : JSR rt_cmp
    BNE is_true : BEQ is_false
.op_lt
    JSR two : JSR rt_cmp
    BCC is_true : BCS is_false
.op_ge
    JSR two : JSR rt_cmp
    BCS is_true : BCC is_false
.op_gt
    JSR two : JSR rt_cmp
    BEQ is_false : BCS is_true : BCC is_false
.op_le
    JSR two : JSR rt_cmp
    BEQ is_true : BCC is_true : BCS is_false
.op_neg
    JSR pop_acc : JSR rt_neg : JMP push_next
.op_abs
    JSR pop_acc : JSR rt_abs : JMP push_next
.op_sgn
    JSR pop_acc : JSR rt_sgn : JMP push_next
.op_not
    JSR pop_acc
    LDA acc : ORA acc+1 : BEQ is_true : BNE is_false
.op_lo
    JSR pop_acc : LDA acc : JMP push_a_next
.op_hi
    JSR pop_acc : LDA acc+1 : JMP push_a_next

\ --- Control -------------------------------------------------------------------
.op_jz
    JSR vm_word : POP_ACC
    LDA acc : ORA acc+1 : BEQ jump
    JMP vm_next
.op_jnz
    JSR vm_word : POP_ACC
    LDA acc : ORA acc+1 : BNE jump
    JMP vm_next
.op_jmp
    JSR vm_word
.jump
    LDA vm_w : STA vpc : LDA vm_w+1 : STA vpc+1
    JMP vm_next
.op_call
    JSR vm_word
    LDA vpc+1 : PHA : LDA vpc : PHA
    JMP jump
.op_ret
    PLA : STA vpc : PLA : STA vpc+1
    JMP vm_next
.op_drop
    INC vsp
    JMP vm_next
\ FOR's loop-back: the slot at bslots + the byte's offset takes the word.
.op_forto
    JSR vm_byte : TAX
    JSR vm_word
    LDA vm_w : STA bslots+4,X : LDA vm_w+1 : STA bslots+5,X
    JMP vm_next
\ NEXT of an empty loop (decision 12): the loop run to its end here, the
\ variable and the slot as the original's leave them.
.op_nextall
{
    JSR vm_word
    \ A step of 1 with the variable not past the limit: it ends the limit
    \ + 1, at once. (Otherwise the loop, step by step.)
    LDX vm_w : LDY vm_w+1
    LDA bslots+2,Y : CMP #1 : BNE again
    LDA bslots+3,Y : BNE again
    TXA : ASL A : STA nx_ptr
    LDA #0 : ROL A : STA nx_ptr+1
    LDA nx_ptr : CLC : ADC #LO(bv + FOR_VARS) : STA nx_ptr
    LDA nx_ptr+1 : ADC #HI(bv + FOR_VARS) : STA nx_ptr+1
    STY eptr                        ; (the slot)
    LDY #0 : LDA (nx_ptr),Y : STA acc
    INY : LDA (nx_ptr),Y : STA acc+1
    LDY eptr
    LDA bslots,Y : STA arg : LDA bslots+1,Y : STA arg+1
    AND bslots,Y : CMP #&FF : BEQ again     ; (32767's loop wraps: the original's way)
    LDA arg+1 : CMP #&7F : BNE cmp
    LDA arg : CMP #&FF : BEQ again
.cmp
    JSR rt_cmp                      ; (the variable against the limit)
    BEQ last : BCS again            ; (past it already: the loop's own way)
.last
    LDY eptr
    CLC
    LDA bslots,Y : ADC #1 : PHA
    LDA bslots+1,Y : ADC #0
    LDY #1 : STA (nx_ptr),Y
    DEY : PLA : STA (nx_ptr),Y
    JMP vm_next
.again
    LDX vm_w : LDY vm_w+1
    JSR rt_next                     ; (C set: past the limit)
    BCC again
    JMP vm_next
}

\ NEXT: the word's low byte the variable (bv + FOR_VARS + 2n), its high
\ byte the slot's offset; back through the slot unless past the limit.
.op_next
{
    JSR vm_word
    LDX vm_w : LDY vm_w+1
    JSR rt_next                     ; (C set: past the limit)
    BCS done
    LDA bslots+4,Y : STA vpc : LDA bslots+5,Y : STA vpc+1
.done
    JMP vm_next
}

\ RND: rt_rnd's generator, the original's.
.op_rnd
    JSR pop_acc : JSR rt_rnd : JMP push_next

\ (The operations that do what only the port can: vmio.6502.)
