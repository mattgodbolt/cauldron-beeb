\ ***************************************************************************
\ Drawing the original's 1-bit characters into MODE 1 cells.
\
\ A Spectrum cell (8 x 8) is 16 bytes: its left four pixels' 8 lines,
\ then its right four's. Paper is black everywhere in the original
\ (docs/research/graphics.md), so a cell is its glyph in one logical
\ colour on logical 0. Cell (row r, column c) is at screen + 512r + 16c.
\ ***************************************************************************

ZA_AUTO2 glyph                  ; the character's 8 bytes
ZA_AUTO2 cell_scr               ; the cell's screen address
ZA_AUTO1 ink_mask               ; cbyte(the logical colour)

\ A Spectrum nibble (its leftmost pixel in bit 3) spread into both halves
\ of a MODE 1 byte, where a pixel's colour bits are 4 apart.
.spread
FOR n = 0..15
    EQUB n * &11
NEXT

\ cbyte of logical colour 0-3.
.colour_bytes
    EQUB cbyte(0), cbyte(1), cbyte(2), cbyte(3)

\ cell_scr = the screen address of row A, column X, and attr_ptr its
\ attribute's.
.cell_at
    JSR attr_at
    ASL A : ADC #HI(screen) : STA cell_scr+1    ; (A < 24: no carry in)
    ASSERT LO(screen) = 0
    TXA : ASL A : ASL A : ASL A : ASL A : STA cell_scr
    BCC cell_at_done : INC cell_scr+1
.cell_at_done
    RTS

\ --- What the scenery drew in each cell -----------------------------------
\ SPRITE colours a pixel by whether the scenery has it lit (decision 5),
\ so each cell keeps its scenery's glyph and colour: tables of 768, a
\ cell's entry at the same offset as its attribute in attrs. They live in
\ the OS's pages 4-12, free once the game owns the machine.
CELL_GLYPH_LO = &0400
CELL_GLYPH_HI = &0700
CELL_HOME     = &0A00           ; the colour byte the cell's ink makes
    ASSERT CELL_HOME + 768 <= &0D00 ; (page 13: the NMI, and BREAK reads it)
ZA_AUTO2 cell_bg                ; cell_info's: the cell's scenery glyph

\ cell_bg = the scenery's glyph in the cell at attr_ptr (cell_at's), and
\ A = its colour byte.
.cell_info
{
    ZA_AUTO2 tab
    LDA attr_ptr : STA tab
    LDA attr_ptr+1 : CLC : ADC #HI(CELL_GLYPH_LO) - HI(attrs) : STA tab+1
    LDY #0 : LDA (tab),Y : STA cell_bg
    LDA tab+1 : CLC : ADC #HI(CELL_GLYPH_HI - CELL_GLYPH_LO) : STA tab+1
    LDA (tab),Y : STA cell_bg+1
    LDA tab+1 : CLC : ADC #HI(CELL_HOME - CELL_GLYPH_HI) : STA tab+1
    LDA (tab),Y
    RTS
}

\ The cell at attr_ptr's scenery is the glyph at `glyph` in ink_mask.
.note_cell
{
    ZA_AUTO2 tab
    LDA attr_ptr : STA tab
    LDA attr_ptr+1 : CLC : ADC #HI(CELL_GLYPH_LO) - HI(attrs) : STA tab+1
    LDY #0 : LDA glyph : STA (tab),Y
    LDA tab+1 : CLC : ADC #HI(CELL_GLYPH_HI - CELL_GLYPH_LO) : STA tab+1
    LDA glyph+1 : STA (tab),Y
    LDA tab+1 : CLC : ADC #HI(CELL_HOME - CELL_GLYPH_HI) : STA tab+1
    LDA ink_mask : STA (tab),Y
    RTS
}
    ASSERT LO(CELL_GLYPH_LO) = 0 AND LO(CELL_GLYPH_HI) = 0 AND LO(CELL_HOME) = 0

IF NOT(DEFINED(VIEWER))
\ The cell at attr_ptr's scenery colour is ink_mask (its glyph kept).
.note_home
{
    ZA_AUTO2 tab
    LDA attr_ptr : STA tab
    LDA attr_ptr+1 : CLC : ADC #HI(CELL_HOME) - HI(attrs) : STA tab+1
    LDY #0 : LDA ink_mask : STA (tab),Y
    RTS
}
ENDIF

\ Cells of rows A to 23 have no scenery: a blank glyph, colour 0.
.clear_cells
{
    ZA_AUTO2 lo
    ZA_AUTO2 hi
    ZA_AUTO2 home
    ZA_AUTO2 count                  ; cells left: 32 * (24 - the row)
    PHA
    LDX #0 : JSR attr_at
    PLA : EOR #&FF : SEC : ADC #24  ; 24 - the row
    LDX #0 : STX count+1
    ASL A : ASL A : ASL A : ROL count+1 : ASL A : ROL count+1 : ASL A : ROL count+1
    STA count
    LDA attr_ptr : STA lo : STA hi : STA home
    LDA attr_ptr+1 : CLC : ADC #HI(CELL_GLYPH_LO) - HI(attrs) : STA lo+1
    CLC : ADC #HI(CELL_GLYPH_HI - CELL_GLYPH_LO) : STA hi+1
    CLC : ADC #HI(CELL_HOME - CELL_GLYPH_HI) : STA home+1
    LDY #0
.cell
    LDA #LO(blank_glyph) : STA (lo),Y
    LDA #HI(blank_glyph) : STA (hi),Y
    LDA #0 : STA (home),Y
    INY : BNE same
    INC lo+1 : INC hi+1 : INC home+1
.same
    LDA count : BNE dec_lo
    DEC count+1
.dec_lo
    DEC count
    LDA count : ORA count+1 : BNE cell
    RTS
}
.blank_glyph    EQUB 0, 0, 0, 0, 0, 0, 0, 0

\ Draw the glyph at `glyph` into the cell at cell_scr in ink_mask, as the
\ cell's scenery (attr_ptr, from cell_at, the cell's).
.draw_cell
{
    ZA_AUTO2 right              ; the right half: cell_scr + 8
    LDA cell_scr : ORA #8 : STA right
    LDA cell_scr+1 : STA right+1
    LDY #7
.line
    LDA (glyph),Y
    LSR A : LSR A : LSR A : LSR A : TAX
    LDA spread,X : AND ink_mask : STA (cell_scr),Y
    LDA (glyph),Y : AND #15 : TAX
    LDA spread,X : AND ink_mask : STA (right),Y
    DEY : BPL line
    \ An empty glyph is noted as blank_glyph, which SPRITE knows on sight.
    LDY #7 : LDA #0
.any
    ORA (glyph),Y
    DEY : BPL any
    TAX : BEQ blank
    JMP note_cell
.blank
    LDA glyph : PHA : LDA glyph+1 : PHA
    LDA #LO(blank_glyph) : STA glyph : LDA #HI(blank_glyph) : STA glyph+1
    JSR note_cell
    PLA : STA glyph+1 : PLA : STA glyph
    RTS
}

\ Clear screen rows A to 23 to logical colour 0, and their cells' scenery.
.clear_rows
{
    PHA : JSR clear_cells : PLA
    ASL A : ADC #HI(screen) : STA page+2
    LDY #0 : TYA
.loop
.page
    STA screen,Y
    INY : BNE loop
    INC page+2 : BPL loop           ; (to the top of main RAM, &8000)
    ASSERT screen + SCREEN_ROWS * ROW_BYTES = &8000
    RTS
}

\ --- Colour ---------------------------------------------------------------
\ A Spectrum ink becomes a logical colour by its row's band (decisions 3
\ and 4): cmaps holds the maps, 8 bytes each (the logical colour of inks
\ 0-7): the panel's rows 0-3, the sky, and the lower band (the landscape
\ screen's or the room's, set as it is drawn). row_map is each row's map's
\ offset in cmaps.
CMAP_SKY   = 4 * 8
CMAP_LOWER = 5 * 8

\ ink_mask for Spectrum ink X (0-7) in row A. Y is kept.
.ink_for
{
    STX ink_mask
    TAX : LDA row_map,X : ORA ink_mask : TAX
    LDA cmaps,X : TAX
    LDA colour_bytes,X : STA ink_mask
    RTS
}

\ The rows' maps outdoors (C set: the sky from row 4 to 15) or
\ underground (C clear: the room from row 4). X is kept.
.set_row_maps
{
    LDA #CMAP_LOWER : BCC rows4
    LDA #CMAP_SKY
.rows4
    LDY #15
.middle
    STA row_map,Y                   ; rows 4-15: the sky's or the lower band's
    DEY : CPY #4 : BCS middle
    LDY #23 : LDA #CMAP_LOWER
.low
    STA row_map,Y                   ; rows 16-23
    DEY : CPY #16 : BCS low
    LDY #3
.panel
    TYA : ASL A : ASL A : ASL A     ; rows 0-3: the panel's own
    STA row_map,Y
    DEY : BPL panel
    RTS
}

\ The fixed bands' maps into cmaps (tools/mkdata.py's bandmaps.bin).
.init_cmaps
{
    LDX #CMAP_LOWER - 1
.copy
    LDA bandmaps,X : STA cmaps,X
    DEX : BPL copy
    RTS
}

\ The lower band's map: the 8 bytes at (cmap_src) into cmaps.
ZA_AUTO2 cmap_src
.set_lower_cmap
{
    LDY #7
.copy
    LDA (cmap_src),Y : STA cmaps + CMAP_LOWER,Y
    DEY : BPL copy
    RTS
}
